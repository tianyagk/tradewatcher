# 统一换行符，避免 Windows 下 LF/CRLF 互转导致整文件 diff 噪音
* text=auto eol=lf

# 明确二进制，禁止任何换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# 平台脚本保留各自惯例
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf

# 锁文件/生成物在 diff 与语言统计中折叠
*.png  -diff
icons/*.png -diff
